APP_NAME=JAPACAR
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://seu-subdominio.infinityfreeapp.com

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Preencha com os dados do MySQL do InfinityFree (painel > MySQL Databases)
DB_CONNECTION=mysql
DB_HOST=sqlXXX.infinityfree.com
DB_PORT=3306
DB_DATABASE=ifXXXXXX_japacar
DB_USERNAME=ifXXXXXX_japacar
DB_PASSWORD=

# Sem SSH/symlink: use drivers de arquivo e fila síncrona
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

BROADCAST_CONNECTION=log
MAIL_MAILER=log

BCRYPT_ROUNDS=12
