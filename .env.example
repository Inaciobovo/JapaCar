# Copie para .env e preencha. O .env NAO deve ser versionado.
#
#   cp .env.example .env
#
# O docker-compose aborta com uma mensagem de erro se SECRET_KEY faltar.
# Esse é o comportamento desejado: subir com uma chave previsível permitiria
# forjar o cookie de sessão e entrar no sistema sem senha.

# Gera uma chave única para este ambiente:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Domínio público do sistema. É o Host confiável (evita Host header injection)
# e o domínio que o Caddy usa para emitir o HTTPS. O compose aborta sem ele.
APP_DOMAIN=japacar.duckdns.org

# Caminho do banco. Em produção o compose monta /app/data a partir do volume.
DATABASE_URL=sqlite:////app/data/japacar.db

# Onde ficam as fotos dos checklists.
UPLOAD_DIR=/app/data/uploads

# Não ligue em produção: o app recusa a subida com o seed ligado, porque ele
# cria admin/admin123. Crie o primeiro usuário por comando:
#   docker compose exec app flask usuario-criar --login admin --perfil ADMIN
SEED_ON_STARTUP=0
